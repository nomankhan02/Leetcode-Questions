class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) 
    {
        int rows = matrix.size();
        int columns = matrix[0].size();

        for(int i = 0; i < rows; i++)
        {
            int start = 0;
            int end = columns - 1;

            while(start <= end)
            {
                int mid = (start + end)/2;

                if(matrix[i][mid] == target)
                {
                    return true;
                    break;
                }
                else if(matrix[i][mid] < target)
                {
                    start = mid + 1;
                }
                else 
                {
                    end = mid - 1;
                }
            }
        }

        return false;
    }
};
