class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) 
    {
        int m = matrix.size();
        int n = matrix[0].size();

        int rows = 0;
        int columns = n-1;

        while(rows < m && columns >= 0)
        {
            if(matrix[rows][columns] == target)
            {
                return true;
                break;
            }
            else if(matrix[rows][columns] > target)
            {
                columns --;
            }
            else
            {
                rows ++;
            }
        }
        return false;
    }
};
