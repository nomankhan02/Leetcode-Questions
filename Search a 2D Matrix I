class Solution 
{
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) 
    {
        int rows = matrix.size();
        int columns = matrix[0].size();
        int start = 0;
        int end = (rows*columns)-1;
        
        while(start <= end)
        {
            int mid = (start + end)/2;
            int r = mid/columns;
            int c = mid % columns;

            if(matrix[r][c] == target)
            {
                return true;
                break;
            }
            else if(matrix[r][c] < target)
            {
                start = mid + 1;
            }
            else
            {
                end = mid - 1;
            }

            
        }
        return false;
    }
};
